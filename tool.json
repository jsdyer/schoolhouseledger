  "access": "browser",
  "data_info": {
    "mode": "snapshot",
    "detail": "BC’s 1894–95 schools report records enrolment and average attendance across school years, alongside each school’s expenditure in the report year.",
    "cadence": "Monthly",
    "probes": [
      {
        "label": "Data retrieved",
        "url": "https://coolcode.ca/schoolhouseledger/data/edition.json",
        "path": [
          "retrieved"
        ],
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "school-year records"
        }
      },
      {
        "label": "School years ending",
        "url": "https://coolcode.ca/schoolhouseledger/data/edition.json",
        "path": [
          "start"
        ],
        "end_path": [
          "end"
        ]
      }
    ]
  }
}
